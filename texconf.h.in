#pragma once 

#cmakedefine LIBTEX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#cmakedefine LIBTEX_VERSION_MINOR @LIBTEX_VERSION_MINOR@
#cmakedefine LIBTEX_VERSION_PATCH @LIBTEX_VERSION_PATCH@
#cmakedefine LIBTEX_VERSION_STRING "@LIBTEX_VERSION_STRING@"

#define LIBTEX_VERSION (LIBTEX_VERSION_MAJOR*10000 + LIBTEX_VERSION_MINOR*100 + LIBTEX_VERSION_PATCH)

#cmakedefine01 LIBTEX_BUILD_SHARED @LIBTEX_BUILD_SHARED@

